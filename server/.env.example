# ============================================================
#  AI 海报设计工作台 —— 环境变量示例
#  复制为 server/.env 后按需填写。所有密钥均为占位符，请勿填入真实值后提交。
# ============================================================

# ---- 服务 ----
NODE_ENV=development
PORT=4000
# 前端地址（用于 CORS）
CLIENT_ORIGIN=http://localhost:5173
# JWT 签名密钥（生产环境务必替换为强随机值）
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
# 会话有效期（秒）
JWT_EXPIRES_IN=604800

# ---- 数据库（SQLite） ----
DB_PATH=./data/app.db

# ---- 文件存储（本地磁盘） ----
UPLOAD_DIR=./uploads
EXPORT_DIR=./exports

# ---- 模型供应商（占位符，部署前由管理员核验官方 API 型号与能力） ----
# 注意：这些 Key 是占位符，未配置时系统自动回退到 mock provider 演示完整流程。
# 供应商 API Key 必须放在服务端环境变量，绝不出现在前端。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Openverse 是无 Key 的兜底源，但部分网络环境可能无法访问。
# 为获得稳定的真实图片搜索，至少配置 Pexels 或 Unsplash Key。
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
# 阿里云百炼（DashScope）通义万相文生图，用于 AI 生成真实海报底图
# 获取：https://bailian.console.aliyun.com/ → API-KEY 管理（国内直连，免费额度）
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1

# 默认启用的文本模型（可配置，不硬编码在 UI）
DEFAULT_TEXT_MODEL=deepseek-v4-pro
# 默认视觉分析模型
DEFAULT_VISION_MODEL=deepseek-flash
# 默认图像生成模型
DEFAULT_IMAGE_MODEL=wanx-v1

# ---- 管理后台初始化管理员 ----
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123456
