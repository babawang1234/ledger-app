# 依赖
node_modules/
**/node_modules/

# 构建产物
client/dist/
server/dist/

# 运行时数据（本地数据库、上传文件、导出文件）
server/data/*.db
server/data/*.db-*
server/data/gen-cache/*
server/uploads/*
server/exports/*
!server/uploads/.gitkeep
!server/exports/.gitkeep

# 运行时生成的设计底图/AI图片（每次搜索/生成动态产出，不入库）
server/public/design-backdrops/*
server/public/ai-images/*
server/public/templates/*
!server/public/design-backdrops/.gitkeep
!server/public/ai-images/.gitkeep
!server/public/templates/.gitkeep

# 环境变量（禁止提交真实密钥）
.env
.env.local
server/.env
server/.env.local
client/.env
client/.env.local

# 日志
*.log
npm-debug.log*

# 编辑器
.vscode/
.idea/
.DS_Store
